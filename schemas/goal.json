{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wisdom:goal:v1",
  "title": "goal",
  "type": "object",
  "required": [
    "title",
    "human_approved"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "human_approved": {
      "const": true
    },
    "owner": {
      "type": "string"
    },
    "epistemic_type": {
      "const": "NORMATIVE_POSITION"
    }
  },
  "additionalProperties": true,
  "description": "Version 1 payload. Runtime services enforce references, scope, rights, temporal order and immutable writes. Internal replay plans use assessment with source lineage."
}
