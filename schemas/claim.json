{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wisdom:claim:v1",
  "title": "claim",
  "type": "object",
  "required": [
    "text",
    "source_id",
    "span_ids",
    "epistemic_type"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "span_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epistemic_type": {
      "enum": [
        "SOURCE_ATTRIBUTED_CLAIM",
        "INTERPRETATION"
      ]
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "accepted",
        "corrected",
        "disputed",
        "rejected"
      ]
    }
  },
  "additionalProperties": true,
  "description": "Version 1 payload. Runtime services enforce references, scope, rights, temporal order and immutable writes. Internal replay plans use assessment with source lineage."
}
