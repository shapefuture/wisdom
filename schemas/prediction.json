{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wisdom:prediction:v1",
  "title": "prediction",
  "type": "object",
  "required": [
    "statement",
    "metric",
    "expected",
    "horizon",
    "analysis_plan",
    "registered_at",
    "preregistration_hash"
  ],
  "properties": {
    "statement": {
      "type": "string"
    },
    "metric": {
      "type": [
        "string",
        "object"
      ]
    },
    "expected": {},
    "direction": {
      "type": "string"
    },
    "horizon": {
      "type": [
        "string",
        "number"
      ]
    },
    "analysis_plan": {
      "type": "string"
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "preregistration_hash": {
      "type": "string"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": true,
  "description": "Version 1 payload. Runtime services enforce references, scope, rights, temporal order and immutable writes. Internal replay plans use assessment with source lineage."
}
