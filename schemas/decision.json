{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wisdom:decision:v1",
  "title": "decision",
  "type": "object",
  "required": [
    "question",
    "owner",
    "options",
    "values",
    "stop_search_when"
  ],
  "properties": {
    "question": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 1
    },
    "values": {
      "type": "array",
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_search_when": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "required": [
        "choice",
        "approved_by"
      ]
    }
  },
  "additionalProperties": true,
  "description": "Version 1 payload. Runtime services enforce references, scope, rights, temporal order and immutable writes. Internal replay plans use assessment with source lineage."
}
