{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wisdom:assessment:v1",
  "title": "assessment",
  "type": "object",
  "required": [],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "route": {
      "enum": [
        "accept_for_purpose",
        "new_region_research",
        "quarantine",
        "refuse"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Version 1 payload. Runtime services enforce references, scope, rights, temporal order and immutable writes. Internal replay plans use assessment with source lineage."
}
